<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Controls.CutSelector">
  <Border Background="{DynamicResource Header}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Cuts}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="cut" Classes.active="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding DataContext.CutCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}" />
              <Button Classes="quiet" Padding="6" Width="30" VerticalAlignment="Stretch" Command="{Binding DataContext.DeleteCutCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}" ToolTip.Tip="{Binding DataContext.DeleteCutHint,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Label,StringFormat='Eliminar {0}'}"><c:VectorIcon Kind="trash" Width="16" Height="16" Stroke="#B53742" /></Button>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="Agregar corte" Command="{Binding AddCutCommand}" ToolTip.Tip="Crear un corte independiente; inicia con 0 % de la nota final" />
        <Button Classes="quiet" Content="Actualizar" Command="{Binding ReloadCourseCommand}" ToolTip.Tip="Volver a leer la materia si otra instancia la modificó" />
        <TextBlock Classes="muted" Text="{Binding SelectedCutWeight}" FontSize="11" VerticalAlignment="Center" Margin="4,0" />
    </StackPanel></Grid>
  </Border>
</UserControl>
