<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Controls.CutSelector">
  <Border Background="#EDF3FA" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="6" Padding="3">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="cut" Classes.active="{Binding SelectedCut,Converter={StaticResource Equals},ConverterParameter=1}" Content="Corte 1" Command="{Binding CutCommand}" CommandParameter="1" />
        <Button Classes="cut" Classes.active="{Binding SelectedCut,Converter={StaticResource Equals},ConverterParameter=2}" Content="Corte 2" Command="{Binding CutCommand}" CommandParameter="2" />
        <Button Classes="cut" Classes.active="{Binding SelectedCut,Converter={StaticResource Equals},ConverterParameter=3}" Content="Corte 3" Command="{Binding CutCommand}" CommandParameter="3" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><Button Classes="quiet" Content="Actualizar" Command="{Binding ReloadCourseCommand}" ToolTip.Tip="Volver a leer la materia si otra instancia la modificó" /><TextBlock Classes="muted" Text="Peso en nota final: pendiente de definición" FontSize="11" MaxWidth="220" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0" />
    </StackPanel></Grid>
  </Border>
</UserControl>
