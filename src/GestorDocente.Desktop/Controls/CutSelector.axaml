<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Controls.CutSelector">
  <Border Background="{DynamicResource Header}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,2">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Grid ColumnDefinitions="Auto,*,Auto" MaxWidth="470" HorizontalAlignment="Left" ColumnSpacing="10">
        <TextBlock Text="Corte académico" VerticalAlignment="Center" FontSize="12"/>
        <ComboBox x:Name="AcademicCutDropdown" Grid.Column="1" ItemsSource="{Binding Cuts}" SelectedItem="{Binding SelectedCutOption,Mode=TwoWay}" IsEnabled="{Binding CanChooseCut}" MinWidth="170" MaxWidth="275" HorizontalAlignment="Stretch" AutomationProperties.Name="Seleccionar corte académico">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Header}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Command="{Binding ConfigureCutsCommand}" ToolTip.Tip="Configurar cortes: agregar, renombrar o eliminar" AutomationProperties.Name="Configurar cortes" Width="42" Height="40" HorizontalContentAlignment="Center"><c:VectorIcon Kind="settings" Width="19" Height="19"/></Button>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="quiet" Content="Actualizar" Command="{Binding ReloadCourseCommand}" ToolTip.Tip="Volver a leer la materia si otra instancia la modificó" />
        <TextBlock Classes="muted" Text="{Binding SelectedCutWeight}" FontSize="11" VerticalAlignment="Center" MaxWidth="185" TextWrapping="Wrap" />
    </StackPanel></Grid>
  </Border>
</UserControl>
