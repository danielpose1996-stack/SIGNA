<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Controls.GradeEditor">
  <Grid RowDefinitions="Auto,Auto" Margin="1,0">
    <TextBox Classes="grade-editor" Classes.filled="{Binding Input,Converter={StaticResource HasText}}" Text="{Binding Input,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Watermark="—" TextAlignment="Center" MinHeight="28" Height="28" Padding="3,2" BorderThickness="0" LostFocus="CommitOnLostFocus" KeyDown="CommitOnEnter" ToolTip.Tip="Nota entre 0,0 y 5,0. Enter para guardar; vacío significa pendiente." AutomationProperties.Name="Calificación" />
    <TextBlock Grid.Row="1" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error,Converter={StaticResource HasText}}" ToolTip.Tip="{Binding Error}" FontSize="10" MaxWidth="90" />
  </Grid>
</UserControl>
