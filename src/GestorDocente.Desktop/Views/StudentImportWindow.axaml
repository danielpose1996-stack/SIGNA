<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.StudentImportWindow" Title="Importar estudiantes desde Excel" Width="1050" Height="720" MinWidth="750" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22" RowSpacing="12">
    <StackPanel Spacing="5">
      <TextBlock Text="Importar estudiantes" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Context}" Classes="muted" FontSize="12" />
      <TextBlock Text="{Binding SourceName}" FontSize="12" />
      <TextBlock Text="Revisa la lista y pulsa Importar todos. Solo se guardan nombre y documento." FontSize="13" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Background="#EDF5FF" BorderBrush="#D5E5FA" BorderThickness="1" CornerRadius="6" Padding="12,9">
      <StackPanel Spacing="4"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding MappingSummary}" FontSize="12" Classes="muted" TextWrapping="Wrap" /></StackPanel>
    </Border>
    <Expander Grid.Row="2" x:Name="ColumnSettings" Header="Corregir columnas" IsExpanded="{Binding SettingsExpanded,Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,170,*" ColumnSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="Hoja" FontSize="12" /><ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Hoja de Excel"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Primera fila de estudiantes" FontSize="12" /><NumericUpDown Value="{Binding FirstDataRow,Mode=TwoWay}" Minimum="1" Maximum="10000" FormatString="0" AutomationProperties.Name="Primera fila de estudiantes" /></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Columna de documento" FontSize="12" /><ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding DocumentColumn,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Columna de documento"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
          </Grid>
          <TextBlock Text="Columnas del nombre completo: elige una o combina nombres y apellidos. Esta selección se aplica a TODOS los estudiantes." FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsName,Mode=TwoWay}" Margin="0,0,16,5" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Expander>
    <DataGrid Grid.Row="3" x:Name="PreviewTable" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Documento" Binding="{Binding Document}" Width="170" MinWidth="120" />
        <DataGridTextColumn Header="Nombre completo" Binding="{Binding Name}" Width="*" MinWidth="230" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="250" MinWidth="190" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Spacing="8">
      <TextBlock Text="Los registros duplicados o incompletos se omiten. Los alumnos existentes y sus notas se conservan." FontSize="12" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" /><Button Classes="primary" Content="{Binding ImportButtonText}" Click="Save" IsEnabled="{Binding CanImport}" /></StackPanel>
    </StackPanel>
  </Grid>
</Window>
