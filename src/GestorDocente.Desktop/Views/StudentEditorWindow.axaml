<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.StudentEditorWindow" Title="{Binding Title}" Width="490" Height="535" MinWidth="430" MinHeight="490" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="15">
    <StackPanel Spacing="6"><TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}"><TextBlock Text="Nombre completo *" /><TextBox Text="{Binding FullName,Mode=TwoWay}" MaxLength="240" AutomationProperties.Name="Nombre completo obligatorio" /><TextBlock Text="Documento (opcional)" /><TextBox Text="{Binding Document,Mode=TwoWay}" MaxLength="80" /><TextBlock Text="Correo electrónico (opcional)" /><TextBox Text="{Binding Email,Mode=TwoWay}" MaxLength="254" /><TextBlock Text="Celular (opcional)" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Phone,Mode=TwoWay}" MaxLength="40" PasswordChar="{Binding PhoneMask}" /><Button Grid.Column="1" Command="{Binding TogglePhoneCommand}" ToolTip.Tip="{Binding EyeLabel}" AutomationProperties.Name="{Binding EyeLabel}"><c:VectorIcon Kind="eye" Width="19" Height="19" /></Button></Grid></StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding CanEdit}" /><Button Content="{Binding ActionLabel}" Classes="primary" Click="Save" IsEnabled="{Binding CanEdit}" /></StackPanel>
  </Grid>
</Window>
