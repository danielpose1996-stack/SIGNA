<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.BackupsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,0,24,24" Spacing="20">
      <Border Background="#EAF3FF" BorderBrush="#D4E5FA" BorderThickness="1" CornerRadius="8" Padding="18">
        <Grid ColumnDefinitions="28,*"><c:VectorIcon Kind="info" Stroke="#0067F5" Width="23" Height="23" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6"><TextBlock Text="Módulo en preparación" FontWeight="SemiBold" /><TextBlock Text="En esta entrega puedes consultar las opciones previstas. La creación y restauración de copias se implementarán primero; después se añadirá la conexión opcional a Google Drive." Foreground="#45638E" TextWrapping="Wrap" /></StackPanel></Grid>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
        <Border Classes="card" Padding="24">
          <StackPanel Spacing="17">
            <c:VectorIcon Kind="backup" Stroke="#0067F5" Width="34" Height="34" HorizontalAlignment="Left" />
            <TextBlock Text="Respaldo local" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Una copia que tú conservas" Classes="muted" />
            <TextBlock Text="Podrás elegir dónde guardar el archivo de respaldo y conservarlo en este equipo, en una memoria externa o subirlo manualmente a tu Drive." TextWrapping="Wrap" />
            <Border Background="#F1F6FD" CornerRadius="5" Padding="14"><StackPanel Spacing="8"><TextBlock Text="Sin cuenta y sin internet" FontWeight="SemiBold" /><TextBlock Text="La copia local incluirá el trabajo académico y se podrá recuperar en otro equipo compatible." Classes="muted" FontSize="13" TextWrapping="Wrap" /></StackPanel></Border>
            <TextBlock Text="Crear respaldo · Pendiente del siguiente incremento" Foreground="#806326" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="24">
          <StackPanel Spacing="17">
            <c:VectorIcon Kind="cloud" Stroke="#0067F5" Width="34" Height="34" HorizontalAlignment="Left" />
            <TextBlock Text="Google Drive" FontSize="21" FontWeight="SemiBold" />
            <Border Background="#F1F6FD" Padding="10,4" CornerRadius="4" HorizontalAlignment="Left"><TextBlock Text="Opcional · Sin conexión configurada" FontSize="12" /></Border>
            <TextBlock Text="Si lo deseas, podrás conectar tu cuenta de Google y enviar una copia desde el programa a tu Drive." TextWrapping="Wrap" />
            <TextBlock Text="La autorización se abrirá en el navegador. Seguirás trabajando localmente si decides no conectarlo." Classes="muted" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="Conectar y enviar · Pendiente de un incremento posterior" Foreground="#806326" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Classes="card" Padding="20">
        <Grid ColumnDefinitions="40,*"><c:VectorIcon Kind="restore" Width="28" Height="28" Stroke="#0067F5" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Restaurar una copia" Classes="section" /><TextBlock Text="El archivo se verificará antes de recuperar sus datos. Se mostrará qué se reemplazará y se conservará una copia recuperable del estado anterior." Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Restauración · Pendiente del siguiente incremento" Foreground="#806326" FontSize="12" /></StackPanel></Grid>
      </Border>
      <Button Content="Volver a Inicio" Command="{Binding NavigateCommand}" CommandParameter="Inicio" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
