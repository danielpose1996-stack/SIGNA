<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.AppearanceWindow" Title="Personalizar apariencia" Width="520" Height="515" MinWidth="440" MinHeight="440" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="7"><TextBlock Text="Personalizar apariencia" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Elige los colores y el icono del perfil. Se conservarán al volver a abrir SIGNA." Classes="muted" TextWrapping="Wrap" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
      <TextBlock Text="{Binding Warning}" Classes="error" IsVisible="{Binding Warning,Converter={StaticResource HasText}}" />
      <TextBlock Text="Paleta de colores" FontWeight="SemiBold" /><ComboBox x:Name="PaletteSelector" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Paleta de colores"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="{Binding Accent}" Width="18" Height="18" CornerRadius="9" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="Icono del perfil" FontWeight="SemiBold" /><ComboBox x:Name="AvatarSelector" ItemsSource="{Binding Avatars}" SelectedItem="{Binding SelectedAvatar,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Icono del perfil"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="{Binding Icon}" Width="20" Height="20" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Border Background="{DynamicResource Soft}" Padding="16" CornerRadius="7"><StackPanel Orientation="Horizontal" Spacing="14"><Border Background="{DynamicResource PrimaryDark}" Width="46" Height="46" CornerRadius="23"><c:VectorIcon Kind="{Binding PreviewAvatarKind}" Stroke="White" Width="24" Height="24" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Uso local" FontWeight="SemiBold" /><TextBlock Text="Perfil sin cuenta requerida" Classes="muted" FontSize="12" /></StackPanel></StackPanel></Border>
      <TextBlock Text="Los colores de notas, asistencia y alertas conservan su significado. Los cambios se aplican al guardar." Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <Button Content="Usar apariencia predeterminada" Command="{Binding DefaultsCommand}" HorizontalAlignment="Left" />
    </StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding CanEdit}" /><Button Content="Guardar apariencia" Classes="primary" Click="Save" IsEnabled="{Binding CanEdit}" /></StackPanel>
  </Grid>
</Window>
