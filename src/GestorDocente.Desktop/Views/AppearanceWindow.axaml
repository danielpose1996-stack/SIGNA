<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.AppearanceWindow" Title="Personalizar apariencia" Width="600" Height="780" MinWidth="500" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="7"><TextBlock Text="Personalizar apariencia" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Personaliza tu perfil y los colores. Se conservarán al volver a abrir SIGNA." Classes="muted" TextWrapping="Wrap" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
      <TextBlock Text="{Binding Warning}" Classes="error" IsVisible="{Binding Warning,Converter={StaticResource HasText}}" />
      <TextBlock Text="Nombre del docente" FontWeight="SemiBold" /><TextBox x:Name="TeacherNameTextBox" Text="{Binding TeacherName,Mode=TwoWay}" MaxLength="120" Watermark="Escribe tu nombre (opcional)" AutomationProperties.Name="Nombre del docente" />
      <TextBlock Text="Paleta de colores" FontWeight="SemiBold" /><ComboBox x:Name="PaletteSelector" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Paleta de colores"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="{Binding Accent}" Width="18" Height="18" CornerRadius="9" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <CheckBox x:Name="CustomColorCheckBox" Content="Usar color personalizado RGB" IsChecked="{Binding UseCustomColor,Mode=TwoWay}" />
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" IsEnabled="{Binding UseCustomColor}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Canales RGB · 0 a 255" Classes="muted" FontSize="12" /><Border Grid.Column="1" Background="{Binding RgbHex}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1" Width="90" Height="26" CornerRadius="4" ToolTip.Tip="{Binding RgbHex}" /></Grid>
          <Grid ColumnDefinitions="50,*,130" ColumnSpacing="10"><TextBlock Text="Rojo" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Red,Mode=TwoWay}" AutomationProperties.Name="Canal rojo" /><NumericUpDown Grid.Column="2" Minimum="0" Maximum="255" Increment="1" FormatString="0" Value="{Binding Red,Mode=TwoWay}" AutomationProperties.Name="Valor rojo RGB" /></Grid>
          <Grid ColumnDefinitions="50,*,130" ColumnSpacing="10"><TextBlock Text="Verde" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Green,Mode=TwoWay}" AutomationProperties.Name="Canal verde" /><NumericUpDown Grid.Column="2" Minimum="0" Maximum="255" Increment="1" FormatString="0" Value="{Binding Green,Mode=TwoWay}" AutomationProperties.Name="Valor verde RGB" /></Grid>
          <Grid ColumnDefinitions="50,*,130" ColumnSpacing="10"><TextBlock Text="Azul" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Blue,Mode=TwoWay}" AutomationProperties.Name="Canal azul" /><NumericUpDown Grid.Column="2" Minimum="0" Maximum="255" Increment="1" FormatString="0" Value="{Binding Blue,Mode=TwoWay}" AutomationProperties.Name="Valor azul RGB" /></Grid>
          <TextBlock Text="{Binding RgbHex}" FontSize="12" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
      <CheckBox x:Name="ColorGradesCheckBox" Content="Colorear notas según rendimiento" IsChecked="{Binding ColorGrades,Mode=TwoWay}" />
      <TextBlock Text="Solo definitivas de corte y Nota consolidada: rojo &lt; 3,0 · amarillo &lt; 4,0 · verde &lt; 4,6 · azul hasta 5,0." Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="Icono del perfil" FontWeight="SemiBold" /><ComboBox x:Name="AvatarSelector" ItemsSource="{Binding Avatars}" SelectedItem="{Binding SelectedAvatar,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Icono del perfil"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="{Binding Icon}" Width="20" Height="20" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Border Background="{DynamicResource Soft}" Padding="16" CornerRadius="7"><Grid ColumnDefinitions="46,*" ColumnSpacing="14"><Border Background="{DynamicResource PrimaryDark}" Width="46" Height="46" CornerRadius="23"><c:VectorIcon Kind="{Binding PreviewAvatarKind}" Stroke="White" Width="24" Height="24" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding PreviewTeacherName}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Perfil sin cuenta requerida" Classes="muted" FontSize="12" /></StackPanel></Grid></Border>
      <TextBlock Text="Los colores de notas, asistencia y alertas conservan su significado. Los cambios se aplican al guardar." Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <Button Content="Usar apariencia predeterminada" Command="{Binding DefaultsCommand}" HorizontalAlignment="Left" />
    </StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding CanEdit}" /><Button Content="Guardar apariencia" Classes="primary" Click="Save" IsEnabled="{Binding CanEdit}" /></StackPanel>
  </Grid>
</Window>
