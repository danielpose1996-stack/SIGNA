<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" xmlns:vm="using:GestorDocente.Desktop.ViewModels" xmlns:s="using:GestorDocente.Desktop.Styles" x:Class="GestorDocente.Desktop.Views.AppearanceWindow" x:DataType="vm:AppearanceViewModel" x:CompileBindings="True" Title="Personalizar apariencia" Width="600" Height="830" MinWidth="470" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
    <StackPanel Spacing="6"><TextBlock Text="Personalizar apariencia" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="El color cambia en tiempo real. Guarda para conservar tu elección al volver a abrir SIGNA." Classes="muted" TextWrapping="Wrap" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
      <TextBlock Text="{Binding Warning}" Classes="error" IsVisible="{Binding Warning,Converter={StaticResource HasText}}" />
      <TextBlock Text="Nombre del docente" FontWeight="SemiBold" /><TextBox x:Name="TeacherNameTextBox" Text="{Binding TeacherName,Mode=TwoWay}" MaxLength="120" Watermark="Escribe tu nombre (opcional)" AutomationProperties.Name="Nombre del docente" />
      <TextBlock Text="Color principal" FontWeight="SemiBold" />
      <c:HsvColorCanvas x:Name="ColorCanvas" Height="190" Hue="{Binding Hue,Mode=OneWay}" Saturation="{Binding Saturation,Mode=OneWay}" Value="{Binding Brightness,Mode=OneWay}" AutomationProperties.Name="Lienzo de saturación y brillo" AutomationProperties.HelpText="Clic o arrastre para elegir. Flechas izquierda/derecha ajustan saturación; arriba/abajo ajustan brillo. También puedes escribir el código HEX." />
      <c:HueColorSlider x:Name="HueSlider" Hue="{Binding Hue,Mode=TwoWay}" Height="32" AutomationProperties.Name="Tono del color" AutomationProperties.HelpText="Flechas izquierda y derecha ajustan el tono; Mayúsculas permite pasos de diez grados." />
      <TextBlock Text="{Binding HsvLabel}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,64" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Código hexadecimal (HEX)" FontSize="12" FontWeight="SemiBold" /><TextBox x:Name="HexColorInput" Text="{Binding HexInput,Mode=TwoWay}" Watermark="#2563EB" MaxLength="7" AutomationProperties.Name="Código hexadecimal del color" /></StackPanel><Border Grid.Column="1" Background="{Binding SelectedHex}" Height="38" VerticalAlignment="Bottom" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource InputLine}" /></Grid>
      <TextBlock Text="{Binding HexError}" Classes="error" IsVisible="{Binding HexError,Converter={StaticResource HasText}}" />
      <CheckBox x:Name="ColorGradesCheckBox" Content="Colorear notas según rendimiento" IsChecked="{Binding ColorGrades,Mode=TwoWay}" />
      <TextBlock Text="Solo definitivas de corte y Nota consolidada: rojo &lt; 3,0 · amarillo &lt; 4,0 · verde &lt; 4,6 · azul hasta 5,0." Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="Icono del perfil" FontWeight="SemiBold" /><ComboBox x:Name="AvatarSelector" ItemsSource="{Binding Avatars}" SelectedItem="{Binding SelectedAvatar,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Icono del perfil"><ComboBox.ItemTemplate><DataTemplate x:DataType="s:AvatarOption"><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="{Binding Icon}" Width="20" Height="20" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Border Background="{DynamicResource Soft}" Padding="12" CornerRadius="7"><Grid ColumnDefinitions="42,*" ColumnSpacing="12"><Border Background="{DynamicResource PrimaryDark}" Width="42" Height="42" CornerRadius="21"><c:VectorIcon Kind="{Binding PreviewAvatarKind}" Stroke="White" Width="24" Height="24" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding PreviewTeacherName}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Perfil sin cuenta requerida" Classes="muted" FontSize="12" /></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding CanEdit}" /><Button Content="Guardar apariencia" Classes="primary" Click="Save" IsEnabled="{Binding CanSave}" /></StackPanel>
  </Grid>
</Window>
