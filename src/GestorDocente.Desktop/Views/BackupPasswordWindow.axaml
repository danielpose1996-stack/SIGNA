<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.BackupPasswordWindow" Width="480" Height="330" MinWidth="420" MinHeight="280" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="14">
    <StackPanel Spacing="8"><TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="La contraseña no se guarda en la aplicación. Consérvala: será necesaria para restaurar en otro equipo." TextWrapping="Wrap" Classes="muted" /></StackPanel>
    <StackPanel Grid.Row="1" Spacing="8"><TextBlock Text="Contraseña (mínimo 12 caracteres)" /><TextBox x:Name="PasswordInput" PasswordChar="*" AutomationProperties.Name="Contraseña del respaldo" /><TextBlock x:Name="ConfirmLabel" Text="Repetir contraseña" /><TextBox x:Name="ConfirmInput" PasswordChar="*" AutomationProperties.Name="Confirmación de contraseña" /><TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" /></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" /><Button Content="Continuar" Classes="primary" Click="Accept" /></StackPanel>
  </Grid>
</Window>
