<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.AttendanceGradingWindow" Title="Nota de asistencia — SIGNA" Width="530" Height="590" MinWidth="450" MinHeight="430" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
    <StackPanel Spacing="7"><TextBlock Text="Nota de asistencia" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding Context}" Classes="muted" TextWrapping="Wrap" /><CheckBox Content="Activar nota de asistencia" IsChecked="{Binding Enabled,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" /><TextBlock Text="Define la nota de cada estado. Se promedian solo las semanas con P, A, J o T. Los registros pendientes y sin clase no se incluyen." FontSize="12" TextWrapping="Wrap" /></StackPanel>
    <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding StateGrades}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,130" ColumnSpacing="12"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Input,Mode=TwoWay}" Watermark="0,0 a 5,0" AutomationProperties.Name="{Binding Label}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}" Classes="error" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding Error,Converter={StaticResource HasText}}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="7"><TextBlock Text="Esta nota es informativa e independiente: no cambia el porcentaje de asistencia ni se incorpora a la nota del corte. Al desactivarla, se conservan los valores guardados." Classes="muted" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" /></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding CanEdit}" /><Button Content="Guardar configuración" Classes="primary" Click="Save" IsEnabled="{Binding CanSave}" /></StackPanel>
  </Grid>
</Window>
