<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.WeeksWindow" Title="Semanas del corte" Width="660" Height="560" MinWidth="560" MinHeight="450" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="22" RowSpacing="12">
    <StackPanel Spacing="6"><TextBlock Text="Semanas del corte" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Clase y actividades permiten registrar P, A, J y T. Sin fechas obligatorias." Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding CountLabel}" FontSize="12" /></StackPanel>
    <StackPanel Grid.Row="1" Spacing="10" IsEnabled="{Binding CanEdit}">
      <TextBlock Text="{Binding EditorLabel}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Tipo de semana" /><Button x:Name="SaveWeekButton" Grid.Column="1" Classes="primary" Content="{Binding SaveLabel}" Click="Save" IsEnabled="{Binding CanSave}" /></Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><CalendarDatePicker SelectedDate="{Binding SelectedDate,Mode=TwoWay}" Watermark="Fecha opcional" SelectedDateFormat="Short" HorizontalAlignment="Stretch" AutomationProperties.Name="Fecha opcional de la semana" /><Button Grid.Column="1" Content="Sin fecha" Command="{Binding ClearDateCommand}" /></Grid>
      <CheckBox x:Name="MarkAllPresentCheckBox" IsVisible="{Binding IsCreating}" Content="Marcar presente a todos" IsChecked="{Binding MarkAllPresent,Mode=TwoWay}" AutomationProperties.Name="Marcar presente a todos al crear esta semana" ToolTip.Tip="Registra P para todos los estudiantes de la materia. Después puedes cambiar cada asistencia individualmente." />
      <Button Content="Cancelar edición" IsVisible="{Binding IsEditing}" Click="CancelEdit" HorizontalAlignment="Left" />
    </StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding Weeks}" SelectedItem="{Binding SelectedWeek,Mode=TwoWay}" IsEnabled="{Binding CanSelectWeek}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="6" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Grid.Row="3" Text="{Binding Error}" Classes="error" />
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="EditWeekButton" Content="Editar semana" Click="Edit" IsEnabled="{Binding CanManage}" /><Button Content="Retirar semana" Click="Remove" IsEnabled="{Binding CanManage}" /></StackPanel><Button Grid.Column="1" Content="Cerrar" Click="CloseDialog" IsEnabled="{Binding CanEdit}" /></Grid>
  </Grid>
</Window>
