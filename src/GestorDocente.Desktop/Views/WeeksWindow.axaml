<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.WeeksWindow" Title="Semanas del corte" Width="600" Height="510" MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="22" RowSpacing="12">
    <StackPanel Spacing="6"><TextBlock Text="Semanas del corte" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Clase y actividades permiten registrar P, A, J y T. Sin fechas obligatorias." Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding CountLabel}" FontSize="12" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Tipo de semana" /><Button Grid.Column="1" Classes="primary" Content="Agregar semana" Click="Add" IsEnabled="{Binding CanAdd}" /></Grid>
    <ListBox Grid.Row="2" ItemsSource="{Binding Weeks}" SelectedItem="{Binding SelectedWeek,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="6" /></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Grid.Row="3" Text="{Binding Error}" Classes="error" />
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto"><Button Content="Retirar semana seleccionada" Click="Remove" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" /><Button Grid.Column="1" Content="Cerrar" Click="CloseDialog" /></Grid>
  </Grid>
</Window>
