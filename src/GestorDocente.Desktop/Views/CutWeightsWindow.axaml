<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.CutWeightsWindow" Title="Configurar porcentajes de los cortes" Width="490" Height="550" MinWidth="430" MinHeight="430" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="8"><TextBlock Text="Porcentajes de los cortes" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Define cuánto aporta cada corte a la nota final. El total debe ser 100 %. Un corte con 0 % conserva sus notas y asistencias." Classes="muted" TextWrapping="Wrap" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Cuts}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,135,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,12" ColumnSpacing="10"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Weight,Mode=TwoWay}" AutomationProperties.Name="Porcentaje del corte" /><TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Error}" Classes="error" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding Validation}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" /></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" IsEnabled="{Binding CanEdit}" /><Button Content="Guardar porcentajes" Classes="primary" Click="Save" IsEnabled="{Binding CanSave}" /></StackPanel>
  </Grid>
</Window>
