<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.ConfigurationWindow" Title="Configuración de evaluaciones" Width="900" Height="660" MinWidth="650" MinHeight="440" WindowStartupLocation="CenterOwner" Background="White">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <StackPanel Spacing="7" Margin="0,0,0,16"><TextBlock Text="Configuración de evaluaciones" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Grupos: suma 100 %. Actividades: suma 100 % dentro de cada grupo." Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Parcial: una actividad de peso interno 100 %. No se eliminan actividades con notas." FontSize="11" Classes="muted" TextWrapping="Wrap" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
      <Grid RowDefinitions="Auto,*,Auto"><TextBlock Text="Grupos de evaluación" Classes="section" Margin="0,0,0,10" /><DataGrid Grid.Row="1" x:Name="GroupsTable" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup,Mode=TwoWay}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Peso %" Binding="{Binding Weight}" Width="75" /><DataGridCheckBoxColumn Header="Parcial" Binding="{Binding IsPartial}" Width="75" /></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button Content="Agregar grupo" Click="AddGroup" /><Button Content="Eliminar" Click="RemoveGroup" /></StackPanel></Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto"><TextBlock Text="Actividades del grupo seleccionado" Classes="section" FontSize="14" Margin="0,0,0,10" /><DataGrid Grid.Row="1" x:Name="ActivitiesTable" ItemsSource="{Binding Activities}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Actividad" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Peso %" Binding="{Binding Weight}" Width="80" /></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button Content="Agregar actividad" Click="AddActivity" /><Button Content="Eliminar" Click="RemoveActivity" /></StackPanel></Grid>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0"><TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error,Converter={StaticResource HasText}}" /><TextBlock Text="Doble clic para editar. Los cambios se aplican solo al corte seleccionado." Classes="muted" FontSize="11" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" /><Button Classes="primary" Content="Guardar configuración" Click="Save" /></StackPanel></StackPanel>
  </Grid>
</Window>
