<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.HomeView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,0,24,24" Spacing="16">
      <Border Background="#FFF8E6" CornerRadius="5" Padding="10" IsVisible="{Binding Message,Converter={StaticResource HasText}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="quiet" Content="Cerrar" Command="{Binding DismissMessageCommand}" /></Grid></Border>
      <c:AdaptiveCatalogHeader>
        <TextBlock Text="Asignaturas del período" Classes="section" />
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding Home.HasCatalog}">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,10,8"><TextBlock Text="Período" VerticalAlignment="Center" /><ComboBox Width="150" ItemsSource="{Binding Home.Semesters}" SelectedItem="{Binding Home.SelectedSemester,Mode=TwoWay}" AutomationProperties.Name="Período académico" /></StackPanel>
          <Button Command="{Binding DeleteSemesterCommand}" Margin="0,0,10,8" AutomationProperties.Name="Eliminar semestre seleccionado" ToolTip.Tip="Eliminar el período seleccionado; requiere confirmar sus materias y registros"><StackPanel Orientation="Horizontal" Spacing="6"><c:VectorIcon Kind="trash" Width="16" Height="16" Stroke="#B53742" /><TextBlock Text="Eliminar semestre" FontSize="12" /></StackPanel></Button>
          <Button Content="Crear semestre" Command="{Binding NewSemesterCommand}" Margin="0,0,10,8" />
          <Button Classes="primary" Content="Crear materia" Command="{Binding NewCourseCommand}" Margin="0,0,0,8" />
        </WrapPanel>
      </c:AdaptiveCatalogHeader>
      <TextBlock Text="Cargando materias…" Classes="muted" IsVisible="{Binding Home.IsLoading}" />
      <Border Background="#FFF0F0" CornerRadius="5" Padding="10" IsVisible="{Binding Home.Error,Converter={StaticResource HasText}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Home.Error}" Foreground="#A52828" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="quiet" Content="Reintentar" Command="{Binding Home.RefreshCommand}" /></Grid></Border>
      <ItemsControl ItemsSource="{Binding Home.Courses}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AdaptiveCardPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card course-tile" Padding="20" MinHeight="270">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="50,*">
                  <Border Background="{DynamicResource Soft}" Width="46" Height="46" CornerRadius="8"><c:VectorIcon Kind="book" Stroke="{DynamicResource AccentText}" Width="24" Height="24" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="5" Margin="0,16,0,0">
                  <Grid ColumnDefinitions="62,*"><TextBlock Text="Código" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Code}" FontSize="12" TextWrapping="Wrap" /></Grid>
                  <Grid ColumnDefinitions="62,*"><TextBlock Text="Período" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Period}" FontSize="12" /></Grid>
                  <Grid ColumnDefinitions="62,*"><TextBlock Text="Grupo" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding GroupLabel}" FontSize="12" TextWrapping="Wrap" /></Grid>
                  <Grid ColumnDefinitions="62,*"><TextBlock Text="Escuela" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding School}" FontSize="12" TextWrapping="Wrap" /></Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,0">
                  <TextBlock Text="{Binding StudentsLabel}" Classes="muted" FontSize="12" />
                  <Border Background="{DynamicResource Soft}" CornerRadius="5" Padding="8,6" IsVisible="{Binding IsDemo}"><TextBlock Text="Materia de demostración · datos ficticios" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" /></Border>
                </StackPanel>
                <Grid Grid.Row="4" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
                  <Border Background="{DynamicResource Line}" Height="1" />
                  <c:AdaptiveCardActions Grid.Row="1" Margin="0,12,0,0">
                    <Button Classes="primary" Content="Abrir materia" HorizontalAlignment="Left" Command="{Binding DataContext.OpenCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Abrir materia disponible" />
                    <Button Command="{Binding DataContext.EditCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsVisible="{Binding CanDelete}" ToolTip.Tip="Editar los datos de esta materia" AutomationProperties.Name="Editar materia"><StackPanel Orientation="Horizontal" Spacing="6"><c:VectorIcon Kind="edit" Width="15" Height="15" /><TextBlock Text="Editar" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Command="{Binding DataContext.DeleteCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsVisible="{Binding CanDelete}" ToolTip.Tip="Eliminar esta materia y sus datos locales" AutomationProperties.Name="Eliminar materia"><c:VectorIcon Kind="trash" Width="18" Height="18" Stroke="#B53742" /></Button>
                  </c:AdaptiveCardActions>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card" Padding="24" IsVisible="{Binding Home.IsEmpty}"><StackPanel Spacing="8"><c:VectorIcon Kind="book" Width="30" Height="30" /><TextBlock Text="Todavía no hay materias" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Crea primero un semestre (por ejemplo, 2026-1) y después una materia." Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
