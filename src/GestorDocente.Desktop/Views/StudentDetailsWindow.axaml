<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.StudentDetailsWindow" Title="Detalles del estudiante" Width="600" Height="460" MinWidth="520" MinHeight="380" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
    <TextBlock Text="Detalles del estudiante" FontSize="23" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" /><TextBlock Text="Documento" Classes="muted" /><TextBlock Text="{Binding Document}" /><TextBlock Text="Correo electrónico" Classes="muted" /><TextBlock Text="{Binding Email}" TextWrapping="Wrap" /><TextBlock Text="Celular" Classes="muted" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PhoneDisplay}" VerticalAlignment="Center" /><Button Grid.Column="1" Command="{Binding TogglePhoneCommand}" ToolTip.Tip="{Binding EyeLabel}" AutomationProperties.Name="{Binding EyeLabel}"><c:VectorIcon Kind="eye" Width="19" Height="19" /></Button></Grid></StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" />
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right"><Button x:Name="EditStudentButton" Content="Editar información" Click="EditInformation" IsEnabled="{Binding CanManage}" Margin="0,0,8,5" /><Button x:Name="DeleteStudentButton" Click="DeleteStudent" IsEnabled="{Binding CanManage}" Margin="0,0,8,5" ToolTip.Tip="Eliminar al estudiante y sus notas/asistencias solo de esta materia"><StackPanel Orientation="Horizontal" Spacing="6"><c:VectorIcon Kind="trash" Stroke="#B53742" Width="16" Height="16" /><TextBlock Text="Eliminar estudiante" /></StackPanel></Button><Button Content="Cerrar" Click="CloseDialog" /></WrapPanel>
  </Grid>
</Window>
