<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.ConsolidatedView">
  <Border Classes="card" Padding="0">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <WrapPanel Margin="10,6" Orientation="Horizontal">
        <TextBox Width="260" Watermark="Buscar estudiante o documento…" Text="{Binding Consolidated.SearchInput,Mode=TwoWay}" Margin="0,0,12,4" AutomationProperties.Name="Filtrar nota consolidada" />
        <Button Content="Configurar porcentajes" Command="{Binding ConfigureCutWeightsCommand}" Margin="0,0,8,4" />
        <Button Content="Generar reporte PDF" Classes="primary" Command="{Binding ExportConsolidatedPdfCommand}" ToolTip.Tip="Incluye la tabla de notas y tarjetas de estudiantes en riesgo con su correo electrónico." Margin="0,0,8,4" />
      </WrapPanel>
      <Grid Grid.Row="1">
        <DataGrid x:Name="ConsolidatedTable" ItemsSource="{Binding Consolidated.Rows}" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="3" RowHeight="NaN" ColumnHeaderHeight="NaN" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="No hay estudiantes que mostrar. Importa el listado en Notas o ajusta la búsqueda." IsVisible="{Binding Consolidated.IsEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" />
      </Grid>
      <Expander x:Name="RiskExpander" Grid.Row="2" IsVisible="{Binding Consolidated.HasRiskStudents}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{Binding Consolidated.RiskSummary}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" ToolTip.Tip="Mostrar u ocultar las tarjetas. Casos críticos primero; desplaza para consultar todos.">
        <Border Padding="12,8">
          <ScrollViewer MaxHeight="166" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Estudiantes en riesgo: críticos primero; desplaza para ver todos"><ItemsControl x:Name="RiskCards" ItemsSource="{Binding Consolidated.RiskStudents}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Width="286" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Header}" Padding="12" Margin="0,0,10,8">
              <StackPanel Spacing="5"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusTone}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding FullName}" ToolTip.Tip="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Email}" ToolTip.Tip="{Binding Email}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MinimumLabel}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
            </Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl></ScrollViewer>
        </Border>
      </Expander>
      <Border Grid.Row="3" Background="{DynamicResource Header}" Padding="12,8" ToolTip.Tip="{Binding Consolidated.CalculationNote}"><StackPanel Spacing="4"><TextBlock x:Name="WeightsSummary" Text="{Binding Consolidated.WeightsLabel}" ToolTip.Tip="{Binding Consolidated.WeightsLabel}" FontSize="11" TextWrapping="Wrap" /><TextBlock x:Name="CalculationDescription" Text="{Binding Consolidated.CalculationNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" /><TextBlock x:Name="CompactCalculationDescription" Text="Aprobación: 3,0 · Nota mínima: promedio ponderado en cortes pendientes. Consulta la ayuda al pasar el cursor." Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="False"/></StackPanel></Border>
    </Grid>
  </Border>
</UserControl>
