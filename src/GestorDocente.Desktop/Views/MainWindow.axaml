<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" xmlns:v="using:GestorDocente.Desktop.Views" x:Class="GestorDocente.Desktop.Views.MainWindow" Title="UNIPAZ · Gestor Académico Docente" Width="1580" Height="960" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid ColumnDefinitions="236,*">
      <Border Background="#EBF2FA" BorderBrush="#DDE7F3" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="14,28,14,20">
          <StackPanel Margin="18,0,0,28" Spacing="3">
            <TextBlock Text="UNIPAZ" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Gestor Académico" FontSize="14" />
            <TextBlock Text="Docente" FontSize="14" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="3">
            <Button x:Name="HomeNavigation" Classes="nav" Classes.active="{Binding IsHome}" Command="{Binding NavigateCommand}" CommandParameter="Inicio"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="home" Width="23" Height="23" /><TextBlock Text="Inicio" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="CoursesNavigation" Classes="nav" Classes.active="{Binding IsCourses}" Command="{Binding NavigateCommand}" CommandParameter="Materias"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="book" Width="23" Height="23" /><TextBlock Text="Mis Materias" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="nav" Command="{Binding ImportStudentsCommand}" ToolTip.Tip="Importar nombre y documento desde un .xlsx para la materia abierta"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="users" Width="23" Height="23" /><TextBlock Text="Estudiantes" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="AcademicNavigation" Classes="nav" Classes.active="{Binding IsAcademicNavigation}" Command="{Binding NavigateCommand}" CommandParameter="Académico" IsEnabled="{Binding HasOpenCourse}"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="edit" Width="23" Height="23" /><TextBlock Text="Notas y Asistencias" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="nav" IsEnabled="False" ToolTip.Tip="Reportes: generación PDF pendiente de especificación"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="document" Width="23" Height="23" /><TextBlock Text="Reportes" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="BackupsNavigation" Classes="nav" Classes.active="{Binding IsBackups}" Command="{Binding NavigateCommand}" CommandParameter="Respaldos"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="backup" Width="23" Height="23" /><TextBlock Text="Respaldos" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="nav" IsEnabled="False" ToolTip.Tip="Configuración general: incremento posterior"><StackPanel Orientation="Horizontal" Spacing="18"><c:VectorIcon Kind="settings" Width="23" Height="23" /><TextBlock Text="Configuración" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="44,*" Margin="10,0">
            <Border Width="42" Height="42" CornerRadius="21" Background="#195AAF"><c:VectorIcon Kind="monitor" Stroke="White" Width="22" Height="22" /></Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Uso local" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Sin cuenta requerida" Classes="muted" FontSize="12" /></StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="38,Auto,Auto,Auto,Auto,*,26">
        <Border BorderBrush="#DFE8F4" BorderThickness="0,0,0,1" Background="#F8FAFD" Padding="22,0">
          <Grid ColumnDefinitions="*,280">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><c:VectorIcon Kind="book" Width="18" Height="18" /><TextBlock Text="Mis Materias" Classes="muted" FontSize="12" IsVisible="{Binding IsCourseContext}" /><c:VectorIcon Kind="chevron" Width="12" Height="12" IsVisible="{Binding IsCourseContext}" /><TextBlock Text="{Binding PageTitle}" FontSize="12" /></StackPanel>
            <TextBox Grid.Column="1" Text="{Binding Search,Mode=TwoWay}" Watermark="Buscar estudiantes…" Height="30" MinHeight="30" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="Buscar estudiantes" IsVisible="{Binding IsCourseContext}" />
            <TextBlock Grid.Column="1" Text="Guardado en este equipo" Classes="muted" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsGlobalContext}" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="24,24,24,18" Spacing="7" IsVisible="{Binding IsGlobalContext}"><TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="Bold" /><TextBlock Text="{Binding PageSubtitle}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
        <Grid x:Name="CourseHeader" Grid.Row="1" ColumnDefinitions="44,*,Auto" Margin="18,8,18,8" IsVisible="{Binding IsCourseContext}">
          <Border Background="#064392" Width="40" Height="40" CornerRadius="7"><c:VectorIcon Kind="monitor" Stroke="White" Width="31" Height="31" /></Border>
          <StackPanel Grid.Column="1" Margin="18,0,10,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding CourseName}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" /><WrapPanel Orientation="Horizontal"><TextBlock Text="{Binding CourseInfo}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="700" Margin="0,0,12,0" /><Border Background="#DAF6E8" CornerRadius="4" Padding="10,3"><TextBlock Text="En curso" Foreground="#06714A" FontSize="12" /></Border></WrapPanel></StackPanel>
          <Button Grid.Column="2" Command="{Binding ImportStudentsCommand}" ToolTip.Tip="Importar únicamente nombre y documento de estudiantes desde un .xlsx para esta materia" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><c:VectorIcon Kind="document" Width="19" Height="19" /><TextBlock Text="Importar Excel" FontSize="12" /></StackPanel></Button>
        </Grid>
        <Border x:Name="CourseTabs" Grid.Row="2" BorderBrush="#DFE8F4" BorderThickness="1" CornerRadius="7" Background="White" Margin="18,0" IsVisible="{Binding IsCourseContext}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="tab" Classes.active="{Binding IsNotes}" Command="{Binding NavigateCommand}" CommandParameter="Notas"><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="grid" Width="21" Height="21" /><TextBlock Text="Notas" /></StackPanel></Button>
            <Button Classes="tab" Classes.active="{Binding IsAttendance}" Command="{Binding NavigateCommand}" CommandParameter="Asistencias"><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="users" Width="21" Height="21" /><TextBlock Text="Asistencias" /></StackPanel></Button>
            <Button Classes="tab" Command="{Binding ConfigureCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="settings" Width="21" Height="21" /><TextBlock Text="Configuración de evaluaciones" /></StackPanel></Button>
            <Button Classes="tab" Command="{Binding ImportStudentsCommand}" ToolTip.Tip="Importar estudiantes desde un .xlsx"><StackPanel Orientation="Horizontal" Spacing="10"><c:VectorIcon Kind="users" Width="21" Height="21" /><TextBlock Text="Estudiantes" /></StackPanel></Button>
          </StackPanel>
        </Border>
        <c:CutSelector Grid.Row="3" Margin="18,6,18,0" IsVisible="{Binding IsCourseContext}" />
        <Grid Grid.Row="4" IsVisible="{Binding IsCourseContext}"><Border Background="#FFF8E6" CornerRadius="5" Padding="10" Margin="18,8,18,0" IsVisible="{Binding Message,Converter={StaticResource HasText}}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><Button Grid.Column="1" Classes="quiet" Content="Cerrar" Command="{Binding DismissMessageCommand}" /></Grid></Border></Grid>
        <Grid Grid.Row="5" Margin="18,6,18,6" IsVisible="{Binding IsCourseContext}"><v:NotesView x:Name="RetainedNotes" IsVisible="{Binding IsNotes}" /><v:AttendanceView x:Name="RetainedAttendance" IsVisible="{Binding IsAttendance}" /></Grid>
        <v:HomeView Grid.Row="2" Grid.RowSpan="4" IsVisible="{Binding IsHomeOrCourses}" />
        <v:BackupsView Grid.Row="2" Grid.RowSpan="4" IsVisible="{Binding IsBackups}" />
        <Border Grid.Row="6" BorderBrush="#E1EAF4" BorderThickness="0,1,0,0" Padding="20,0"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="{Binding StorageLabel}" FontWeight="SemiBold" FontSize="10" Foreground="#0067F5" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Classes="muted" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
      </Grid>
    </Grid>
    <Border x:Name="ModalOverlay" Background="#330B2450" IsVisible="False" />
  </Grid>
</Window>
