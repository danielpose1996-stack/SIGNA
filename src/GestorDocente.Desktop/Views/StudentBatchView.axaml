<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.StudentBatchView">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
    <StackPanel Spacing="5">
      <TextBlock Text="1. Pega las listas en el mismo orden" FontWeight="SemiBold" FontSize="15" />
      <TextBlock Text="Un estudiante por línea. Solo el nombre es obligatorio. Si usas una columna opcional, pega el mismo número de filas y deja líneas vacías donde falten datos." Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid MinWidth="800" ColumnDefinitions="2*,*,1.5*,*" ColumnSpacing="10" IsEnabled="{Binding CanEdit}">
        <StackPanel Spacing="5"><TextBlock Text="Nombres completos *" FontSize="12" FontWeight="SemiBold" /><TextBox x:Name="BulkNamesInput" Text="{Binding Names,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" Height="135" MaxLength="1210000" FontSize="12" Watermark="Ana María Ejemplo&#10;Carlos Ejemplo&#10;Luisa Ejemplo" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Nombres completos, uno por línea" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Documentos" FontSize="12" /><TextBox Text="{Binding Documents,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" Height="135" MaxLength="410000" FontSize="12" Watermark="Opcional" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Documentos, una fila por estudiante" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Correos electrónicos" FontSize="12" /><TextBox Text="{Binding Emails,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" Height="135" MaxLength="1280000" FontSize="12" Watermark="Opcional" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Correos electrónicos, una fila por estudiante" /></StackPanel>
        <StackPanel Grid.Column="3" Spacing="5"><TextBlock Text="Celulares" FontSize="12" /><TextBox Text="{Binding Phones,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" Height="135" MaxLength="210000" FontSize="12" Watermark="Opcional" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Celulares, una fila por estudiante" /></StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Text="2. Revisa los datos antes de agregar" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Revisar lista" Command="{Binding PreviewCommand}" ToolTip.Tip="Valida todas las filas sin guardar todavía" />
    </Grid>
    <DataGrid Grid.Row="3" x:Name="BulkStudentsPreviewTable" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" ColumnHeaderHeight="36" RowHeight="NaN" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
        <DataGridTemplateColumn Header="Nombre completo" Width="2*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FullName}" TextWrapping="Wrap" Margin="5" FontSize="12" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Documento" Binding="{Binding Document}" Width="125" />
        <DataGridTemplateColumn Header="Correo electrónico" Width="1.5*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Email}" TextWrapping="Wrap" Margin="5" FontSize="12" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Celular" Binding="{Binding PhoneDisplay}" Width="125" />
        <DataGridTemplateColumn Header="Validación" Width="1.5*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" Margin="5" FontSize="12" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Spacing="4">
      <CheckBox Content="Mostrar celulares en la vista previa" IsChecked="{Binding ShowPhones,Mode=TwoWay}" FontSize="12" />
      <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" FontSize="12" />
      <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
  </Grid>
</UserControl>
