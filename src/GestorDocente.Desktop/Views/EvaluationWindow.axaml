<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.EvaluationWindow" Title="Evaluar actividad con rúbrica" Width="610" Height="590" MinWidth="500" MinHeight="380" WindowStartupLocation="CenterOwner" Background="White">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="6" Margin="0,0,0,18"><TextBlock Text="Evaluación por rúbrica" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding Title}" FontSize="16" /><TextBlock Text="{Binding StudentName}" Classes="muted" /><TextBlock Text="Cada criterio se califica entre 0,0 y 5,0." Classes="muted" FontSize="12" /></StackPanel>
    <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Scores}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,10" Padding="12"><Grid ColumnDefinitions="*,100"><StackPanel Spacing="5" Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding WeightLabel}" FontSize="11" Foreground="#0067F5" /></StackPanel><NumericUpDown Grid.Column="1" Value="{Binding Score,Mode=TwoWay}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.00" VerticalAlignment="Center" AutomationProperties.Name="Puntaje del criterio" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="{Binding Result}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error,Converter={StaticResource HasText}}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancelar" Click="Cancel" /><Button Classes="primary" Content="Guardar evaluación" Click="Save" /></StackPanel></StackPanel>
  </Grid>
</Window>
