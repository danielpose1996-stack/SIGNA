<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GestorDocente.Desktop.Views.RecoveryStartupWindow" Title="SIGNA · recuperar datos locales" Width="680" Height="340" MinWidth="540" MinHeight="280" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28" RowSpacing="16">
    <StackPanel Spacing="10"><TextBlock Text="No se pudo abrir el catálogo local" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="Explanation" TextWrapping="Wrap" /><TextBlock Text="Puedes restaurar un respaldo .aulabk. Las copias nuevas no necesitan contraseña; las antiguas cifradas conservan su contraseña original. Antes del reemplazo se preservará una copia del archivo actual si es posible leerlo. Cierra otras instancias del programa." TextWrapping="Wrap" Classes="muted" /></StackPanel>
    <TextBlock x:Name="Status" Grid.Row="1" TextWrapping="Wrap" Classes="error" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cerrar" Click="CloseWindow" /><Button x:Name="RestoreButton" Classes="primary" Content="Elegir respaldo y restaurar" Click="Restore" /></StackPanel>
  </Grid>
</Window>
