<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:GestorDocente.Desktop.Controls" x:Class="GestorDocente.Desktop.Views.AttendanceView">
  <Grid ColumnDefinitions="*,320" ColumnSpacing="12">
    <Grid RowDefinitions="Auto,12,*">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Semanas del corte" Classes="section" />
          <Border Background="#EBF4FF" CornerRadius="5" Padding="10"><StackPanel Orientation="Horizontal" Spacing="9"><c:VectorIcon Kind="info" Stroke="#0067F5" Width="20" Height="20" /><TextBlock Text="Agrega semanas cuando dictes clase. Puedes omitir festivos y eventos institucionales." FontSize="12" Foreground="#476B9F" TextWrapping="Wrap" /></StackPanel></Border>
          <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Weeks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#ECFBF3" BorderBrush="#D3F0E1" BorderThickness="1" CornerRadius="6" Padding="12" Width="134" Height="74"><Grid ColumnDefinitions="23,*"><c:VectorIcon Kind="calendar" Stroke="#078D55" Width="22" Height="22" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="9"><TextBlock Text="{Binding Number,StringFormat='Semana {0}'}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Clase registrada" FontSize="10" Classes="muted" /></StackPanel></Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="1" Command="{Binding AddWeekCommand}" Margin="10,0,0,0" Height="74" ToolTip.Tip="Máximo nueve semanas por corte; se agrega solo una a la vez"><StackPanel Spacing="6"><c:VectorIcon Kind="plus" Stroke="#0067F5" Width="23" Height="23" HorizontalAlignment="Center" /><TextBlock Text="Agregar semana" Foreground="#0067F5" FontSize="12" /></StackPanel></Button>
          </Grid>
          <TextBlock Text="Máximo 9 semanas por corte · sin fechas obligatorias" Classes="muted" FontSize="10" />
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Classes="card" Padding="0">
        <Grid RowDefinitions="50,*,32">
          <Grid ColumnDefinitions="240,*,Auto" Margin="10,6">
            <TextBox Text="{Binding Search,Mode=TwoWay}" Watermark="Buscar estudiante…" AutomationProperties.Name="Filtrar tabla de asistencia" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><TextBlock Text="P Presente" Foreground="#128258" FontSize="11" /><TextBlock Text="A Ausente" Foreground="#BD3849" FontSize="11" /><TextBlock Text="J Justificada" Foreground="#99711B" FontSize="11" /><TextBlock Text="T Tarde" Foreground="#824BC0" FontSize="11" /></StackPanel>
          </Grid>
          <DataGrid Grid.Row="1" x:Name="AttendanceTable" ItemsSource="{Binding AttendanceRows}" SelectedItem="{Binding SelectedStudent,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="3" SelectionMode="Single" />
          <TextBlock Grid.Row="1" Text="No hay estudiantes que coincidan con la búsqueda." IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="— Sin diligenciar · no cuenta como ausencia" Classes="muted" FontSize="11" Margin="12,8" />
        </Grid>
      </Border>
    </Grid>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <Border Classes="card"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><c:VectorIcon Kind="chart" Stroke="#0067F5" Width="22" Height="22" /><TextBlock Text="Resumen de asistencia" Classes="section" /></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Border Background="#F5F9FF" CornerRadius="5" Padding="12"><StackPanel Spacing="15"><TextBlock Text="Total estudiantes" Classes="muted" FontSize="12" /><TextBlock Text="{Binding StudentCount}" FontSize="32" FontWeight="Bold" /></StackPanel></Border><Border Grid.Column="1" Background="#F5F9FF" CornerRadius="5" Padding="8"><StackPanel Spacing="6"><TextBlock Text="Promedio" HorizontalAlignment="Center" FontSize="12" /><Border Width="85" Height="85" CornerRadius="43" BorderThickness="9" BorderBrush="#DAE6F3" Background="White"><TextBlock Text="—" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Política por definir" Classes="muted" FontSize="10" HorizontalAlignment="Center" /></StackPanel></Border></Grid></StackPanel></Border>
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:VectorIcon Kind="users" Stroke="#0067F5" Width="22" Height="22" /><TextBlock Text="Detalle del estudiante" Classes="section" /></StackPanel>
            <ComboBox ItemsSource="{Binding AttendanceRows}" SelectedItem="{Binding SelectedStudent,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Seleccionar estudiante"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}" FontSize="12" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <StackPanel DataContext="{Binding SelectedStudent}" Spacing="7">
              <Grid ColumnDefinitions="100,*"><TextBlock Text="Documento:" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Document}" FontSize="12" /></Grid>
              <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="100,*"><TextBlock Text="Registrados:" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Summary.Recorded}" FontSize="12" /></Grid>
              <TextBlock Text="Porcentaje: pendiente de política aprobada" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <Button Classes="primary" IsEnabled="False" ToolTip.Tip="Generación PDF pendiente de especificación" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="9"><c:VectorIcon Kind="document" Stroke="White" Width="20" Height="20" /><TextBlock Text="Generar reporte PDF" Foreground="White" FontSize="12" /></StackPanel></Button>
              <TextBlock Text="PDF pendiente de implementación" Classes="muted" FontSize="10" HorizontalAlignment="Center" />
              <Border Height="1" Background="#E1EAF4" Margin="0,3" />
              <TextBlock Text="Registro por semana" FontWeight="SemiBold" FontSize="13" />
              <ItemsControl ItemsSource="{Binding WeeklyDetails}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="80,35,*" Margin="0,4"><TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" /><Border Grid.Column="1" Background="#EDF4FC" CornerRadius="3" Padding="5"><TextBlock Text="{Binding Code}" FontSize="12" HorizontalAlignment="Center" /></Border><TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="Resumen de estados" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0" />
              <UniformGrid Columns="4">
                <Border Background="#E9FBF1" CornerRadius="4" Margin="0,0,5,0" Padding="5,10"><StackPanel Spacing="5"><TextBlock Text="P" Foreground="#078653" HorizontalAlignment="Center" /><TextBlock Text="{Binding Summary.Present}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Presente" FontSize="9" HorizontalAlignment="Center" /></StackPanel></Border>
                <Border Background="#FFF0F0" CornerRadius="4" Margin="0,0,5,0" Padding="5,10"><StackPanel Spacing="5"><TextBlock Text="A" Foreground="#C63E4B" HorizontalAlignment="Center" /><TextBlock Text="{Binding Summary.Absent}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Ausente" FontSize="9" HorizontalAlignment="Center" /></StackPanel></Border>
                <Border Background="#FFF8E6" CornerRadius="4" Margin="0,0,5,0" Padding="5,10"><StackPanel Spacing="5"><TextBlock Text="J" Foreground="#A67712" HorizontalAlignment="Center" /><TextBlock Text="{Binding Summary.Justified}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Justificada" FontSize="9" HorizontalAlignment="Center" /></StackPanel></Border>
                <Border Background="#F6EEFF" CornerRadius="4" Padding="5,10"><StackPanel Spacing="5"><TextBlock Text="T" Foreground="#8745C7" HorizontalAlignment="Center" /><TextBlock Text="{Binding Summary.Late}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Tarde" FontSize="9" HorizontalAlignment="Center" /></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
