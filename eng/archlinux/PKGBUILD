# Binary distribution of SIGNA; built from the verified self-contained Linux payload.
pkgname=signa
pkgver=__VERSION__
pkgrel=1
pkgdesc='Sistema Integral de Gestión de Notas y Asistencias'
arch=('x86_64')
url='https://github.com/danielpose1996-stack/SIGNA'
license=('MIT')
depends=('glibc>=2.35' 'gcc-libs' 'zlib' 'openssl' 'icu' 'krb5'
         'libx11' 'libice' 'libsm' 'fontconfig' 'freetype2'
         'ca-certificates' 'tzdata' 'hicolor-icon-theme' 'xorg-xwayland')
options=('!strip' '!debug')
source=('signa-payload.tar.gz')
sha256sums=('__SHA256__')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
  install -Dm644 "$srcdir/usr/lib/signa/LICENSE" "$pkgdir/usr/share/licenses/signa/LICENSE"
}
